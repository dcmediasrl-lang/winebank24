# ─────────────────────────────────────────────────────────────────────────────
# Wine Bank 24 — modello delle variabili d'ambiente
#
# Copia questo file in `.env` e riempi i valori. Il file `.env` NON va mai
# caricato su GitHub: contiene le chiavi di accesso a database e pagamenti.
#
# Il modo più rapido per ottenere tutti i valori reali:
#     npx vercel link          (collega la cartella al progetto)
#     npx vercel env pull .env (scarica le variabili di produzione)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase → Settings → Database → Connection string → Session pooler)
# Usa il "session pooler" e non la stringa "direct": funziona su ogni rete.
DATABASE_URL="postgresql://postgres.PROGETTO:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?schema=public"

# ── Autenticazione
# AUTH_SECRET va conservato: se cambia, tutti gli utenti vengono disconnessi.
# Per generarne uno nuovo: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="https://app.winebank24.eu"

# ── Accesso con Google (Google Cloud Console → Credenziali → ID client OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Pagamenti (Stripe → Sviluppatori → Chiavi API)
# In sviluppo usa le chiavi di test (sk_test_… / pk_test_…).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Per provare i webhook in locale: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# ── Email transazionali (Brevo → SMTP & API → Chiavi API)
BREVO_API_KEY=""
EMAIL_FROM="noreply@winebank24.eu"

# ── Immagini (Cloudflare R2 → Gestisci token API)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://pub-XXXXXXXX.r2.dev"

# ── Applicazione
NEXT_PUBLIC_APP_URL="https://app.winebank24.eu"
NEXT_PUBLIC_APP_NAME="Wine Bank 24"

# ── Blockchain — NON ATTIVA
# L'integrazione Polygon è sviluppata ma non attivata: finché queste variabili
# restano vuote i certificati vivono solo sul database e il sito non menziona
# la blockchain. Vedi il ticket WB-05 dell'audit.
POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"
PLATFORM_WALLET_PRIVATE_KEY=""
NFT_CONTRACT_ADDRESS=""

# ── Pubblicità (opzionale: senza publisher ID lo spazio non compare)
NEXT_PUBLIC_ADSENSE_ID=""
