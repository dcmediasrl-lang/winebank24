generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CANTINA
  COLLECTOR
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NftStatus {
  MINTED
  LISTED
  SOLD
  BURN_REQUESTED
  BURNED
  LIQUIDATION_REQUESTED
  LIQUIDATED
}

enum TransactionType {
  MINT
  BUY
  SELL
  BURN
  FEE
}

enum PaymentMethod {
  FIAT
  CRYPTO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(COLLECTOR)
  isBlocked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // KYC light
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  country       String?
  fiscalCode    String?
  documentUrl   String?
  kycVerifiedAt DateTime?

  // Security
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean  @default(false)
  // Buyer contract
  buyerContractAcceptedAt DateTime?
  buyerContractVersion    String?

  username  String?  @unique
  avatarUrl String?

  accounts         Account[]
  sessions         Session[]
  cantina          Cantina?
  nftsOwned        Nft[]           @relation("NftOwner")
  buyTransactions  Transaction[]   @relation("Buyer")
  sellTransactions Transaction[]   @relation("Seller")
  nftFractions     NftFraction[]
  activityLogs     ActivityLog[]
  offersMade       Offer[]         @relation("OfferBuyer")
  offersReceived   Offer[]         @relation("OfferSeller")
  wishlistItems    WishlistItem[]
  favoriteNfts     FavoriteNft[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cantina {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  description String?
  location    String?
  website     String?
  vatNumber   String?
  logoUrl     String?
  isVerified  Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  royaltyPct  Float    @default(5.0)
  // Contractual
  contractAcceptedAt      DateTime?
  contractVersion         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections Collection[]
  nfts        Nft[]
}

model Collection {
  id          String   @id @default(cuid())
  cantinaId   String
  name        String
  description String?
  vintage     Int?
  grape       String?
  region      String?
  coverImage  String?
  totalSupply Int
  minted      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cantina     Cantina  @relation(fields: [cantinaId], references: [id], onDelete: Cascade)
  nfts        Nft[]
}

model Nft {
  id              String    @id @default(cuid())
  tokenId         Int?      @unique
  txHash          String?
  contractAddress String?
  collectionId    String
  cantinaId       String
  ownerId         String
  name            String
  description     String?
  imageUrl        String?   // cover image (first of gallery)
  imageGallery    String[]  // all uploaded image URLs (1–4)
  metadataUri     String?
  status          NftStatus @default(MINTED)
  price           Float?
  isListed        Boolean   @default(false)
  bottleNumber    Int
  vintage         Int?
  isFractionable  Boolean   @default(false)
  totalValue      Decimal?  @db.Decimal(10,2)
  availableValue  Decimal?  @db.Decimal(10,2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collection   Collection    @relation(fields: [collectionId], references: [id])
  cantina      Cantina       @relation(fields: [cantinaId], references: [id])
  owner        User          @relation("NftOwner", fields: [ownerId], references: [id])
  transactions Transaction[]
  burnRequest  BurnRequest?
  fractions    NftFraction[]
  offers       Offer[]
  favoritedBy  FavoriteNft[]
}

model Transaction {
  id            String          @id @default(cuid())
  nftId         String
  buyerId       String?
  sellerId      String?
  type          TransactionType
  amount        Float
  platformFee   Float           @default(0)
  cantinaFee    Float           @default(0)
  paymentMethod PaymentMethod   @default(FIAT)
  stripeId      String?
  txHash        String?
  createdAt     DateTime        @default(now())

  nft    Nft   @relation(fields: [nftId], references: [id])
  buyer  User? @relation("Buyer", fields: [buyerId], references: [id])
  seller User? @relation("Seller", fields: [sellerId], references: [id])
}

model BurnRequest {
  id          String    @id @default(cuid())
  nftId       String    @unique
  requestedBy String
  address     String
  notes       String?
  approved    Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  nft Nft @relation(fields: [nftId], references: [id])
}

model NftFraction {
  id             String   @id @default(cuid())
  nftId          String
  ownerId        String
  percentage     Decimal  @db.Decimal(8,4)
  investedAmount Decimal  @db.Decimal(10,2)
  isListed       Boolean  @default(false)
  askingPrice    Decimal? @db.Decimal(10,2)
  // Partial sale: how much of this fraction is listed for sale
  // If null when isListed=true, the entire fraction is for sale
  listedPercentage Decimal? @db.Decimal(8,4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nft     Nft     @relation(fields: [nftId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])
  offers  Offer[]
}

model PlatformConfig {
  id             String   @id @default(cuid())
  platformFeePct Float    @default(2.5)
  cantinaFeePct  Float    @default(5.0)
  updatedAt      DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model RateLimit {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(0)
  resetAt DateTime

  @@index([key])
}

model Offer {
  id         String      @id @default(cuid())
  nftId      String?
  fractionId String?
  buyerId    String
  sellerId   String
  amount     Float
  message    String?
  status     OfferStatus @default(PENDING)
  expiresAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  nft      Nft?         @relation(fields: [nftId], references: [id])
  fraction NftFraction? @relation(fields: [fractionId], references: [id])
  buyer    User         @relation("OfferBuyer",  fields: [buyerId],  references: [id])
  seller   User         @relation("OfferSeller", fields: [sellerId], references: [id])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  cantina   String?
  wineName  String
  vintage   String?
  grape     String?
  maxPrice  Decimal? @db.Decimal(10, 2)
  notes     String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FavoriteNft {
  id        String   @id @default(cuid())
  userId    String
  nftId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  nft  Nft  @relation(fields: [nftId], references: [id], onDelete: Cascade)

  @@unique([userId, nftId])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleIt     String
  titleEn     String
  excerptIt   String?
  excerptEn   String?
  contentIt   String
  contentEn   String
  coverImage  String?
  category    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
}
